<configuration>

    <!-- Appender para mostrar los logs en consola -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} - %msg%n</pattern>
        </encoder>
        <filter class="ames.comercial.CustomLogFilter" />
    </appender>

    <!-- Log para las consultas SQL de P6Spy -->
    <logger name="com.p6spy" level="DEBUG">
        <appender-ref ref="CONSOLE"/>
    </logger>

    <!-- Appender de LOKI només per producció -->
    <springProfile name="produccio">
        <appender name="LOKI" class="com.github.loki4j.logback.Loki4jAppender">
            <http>
                <url>http://monitoringsvr.ames:3100/loki/api/v1/push</url>
            </http>
            <format>
                <label>
                    <pattern>app=comercial,host=${HOSTNAME},userId=%X{userId:-unknown},user=%X{user:-unknown},ip=%X{ip:-unknown}</pattern>
                </label>
                <message>
                    <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level userId=%X{userId:-unknown} %logger{36} - %msg%n</pattern>
                </message>
            </format>
        </appender>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="LOKI"/>
        </root>
    </springProfile>

    <springProfile name="!produccio">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

</configuration>